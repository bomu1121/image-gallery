# 环境
VITE_APP_NODE_ENV = 'development'

# 公共路径
VITE_APP_PUBLIC_PATH = "/"

# 接口基础url (vite.config.proxy.js 中设置了代理访问, 所以这里不设置)
VITE_APP_BASE_URL = ''

# 接口公共前缀
VITE_APP_API_PUBLIC_PREFIX = '/api'

# 获取文件url地址 (vite.config.proxy.js 中设置了代理访问, 所以这里不设置)
VITE_APP_IMAGE_BASE_URL = ''

# 页面中引入示例
# import.meta.env.VITE_APP_BASE_URL

